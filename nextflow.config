nextflow.enable.dsl = 2
manifest {
 name = 'klvsjeju/wf-virus-longread'
 author = 'klvsjeju'
 homePage = 'https://github.com/klvsjeju/wf-virus-longread'
 description = 'VZV reference analysis or de novo contigs only'
 version = '0.3.0'
 mainScript = 'main.nf'
 nextflowVersion = '>=24.10.0'
}
params {
 fastq = null
 sample = 'sample'
 sample_sheet = null
 analyse_unclassified = false
 reference_based_assembly = false
 reference = null
 override_basecaller_cfg = null
 model_dir = null
 model_map = null
 run_annotation = false
 snpeff_config = null
 snpeff_data = null
 snpeff_db = null
 flye_genome_size = 125000
 flye_opts = ''
 mask_depth_opts = ''
 consensus_opts = ''
 threads = 4
 memory = '4 GB'
 out_dir = null
 container = 'wf-virus-longread:0.3.0'
 min_mapq = 20
 min_coverage = 30
 mask_depth = 0
 help = false
}
// Resolve the default output before execution report paths are configured.
if (!params.out_dir && params.fastq) {
 def inputPath = java.nio.file.Paths.get(params.fastq.toString()).toAbsolutePath().normalize()
 def inputFolder = java.nio.file.Files.isDirectory(inputPath) ? inputPath : inputPath.parent
 params.out_dir = inputFolder.resolve('analysis_result').toString()
}

process {
 executor = 'local'
 cpus = params.threads
 memory = '4 GB'
 maxForks = 1
 container = params.container
 shell = ['/bin/bash', '-euo', 'pipefail']
 errorStrategy = 'terminate'
}
docker.enabled = true
profiles {
 standard { docker.enabled = true }
 local { docker.enabled = false }
}
report { enabled = true; file = "${params.out_dir ?: 'output'}/execution/report.html"; overwrite = true }
timeline { enabled = true; file = "${params.out_dir ?: 'output'}/execution/timeline.html"; overwrite = true }
trace { enabled = true; file = "${params.out_dir ?: 'output'}/execution/trace.tsv"; overwrite = true }
