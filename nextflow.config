nextflow.enable.dsl = 2
manifest {
 name = 'wf-vzv-longread'
 description = 'VZV reference analysis or de novo contigs only'
 version = '0.2.0'
 mainScript = 'main.nf'
 nextflowVersion = '>=24.10.0'
}
params {
 fastq = null
 sample = 'sample'
 sample_sheet = null
 analyse_unclassified = false
 reference_based_assembly = false
 reference = null
 override_basecaller_cfg = null
 model_dir = null
 model_map = null
 snpeff_config = null
 snpeff_data = null
 snpeff_db = null
 flye_genome_size = 125000
 flye_read_type = 'nano-hq'
 flye_opts = ''
 mask_depth_opts = ''
 consensus_opts = ''
 threads = 4
 memory = '12 GB'
 out_dir = 'output'
 container = 'wf-vzv:0.2.0'
 min_mapq = 20
 min_coverage = 30
 mask_depth = 0
 help = false
}
process {
 executor = 'local'
 cpus = params.threads
 memory = params.memory
 maxForks = 1
 container = params.container
 shell = ['/bin/bash', '-euo', 'pipefail']
 errorStrategy = 'terminate'
}
docker.enabled = true
profiles {
 standard { docker.enabled = true }
 local { docker.enabled = false }
}
report { enabled = true; file = "${params.out_dir}/execution/report.html"; overwrite = true }
timeline { enabled = true; file = "${params.out_dir}/execution/timeline.html"; overwrite = true }
trace { enabled = true; file = "${params.out_dir}/execution/trace.tsv"; overwrite = true }
