nextflow.enable.dsl = 2
manifest {
 name = 'klvsjeju/wf-virus-longread'
 author = 'klvsjeju'
 homePage = 'https://github.com/klvsjeju/wf-virus-longread'
 description = 'VZV reference analysis or de novo contigs only'
 version = '0.3.3'
 mainScript = 'main.nf'
 nextflowVersion = '>=23.04.2'
}
params {
 fastq = null
 sample = null
 sample_sheet = null
 analyse_unclassified = false
 reference_based_assembly = false
 reference = null
 override_basecaller_cfg = null
 model_dir = null
 model_map = null
 run_annotation = false
 snpeff_config = null
 snpeff_data = null
 snpeff_db = null
 flye_genome_size = 125000
 flye_opts = ''
 min_read_length = 1000
 mask_depth_opts = ''
 consensus_opts = ''
 threads = 4
 memory = '4 GB'
 out_dir = null
 container = null
 images {
   wf_common = 'ontresearch/wf-common:shafdd79f8e4a6faad77513c36f623693977b92b08e'
   wf_bacterial = 'ontresearch/wf-bacterial-genomes:shab005a1bd7d4bb439bd864fecf5223e2741a53631'
   clair3 = 'hkubal/clair3:v1.2.0'
   nanoplot = 'quay.io/biocontainers/nanoplot:1.43.0--pyhdfd78af_1'
   deeptools = 'quay.io/biocontainers/deeptools:3.5.5--pyhdfd78af_0'
   snpeff = 'quay.io/biocontainers/snpeff:5.4.0c--hdfd78af_0'
   snpsift = 'quay.io/biocontainers/snpsift:5.2--hdfd78af_0'
 }
 min_mapq = 20
 min_coverage = 30
 mask_depth = 0
 help = false
}
// Resolve the default output before execution report paths are configured.
if (!params.out_dir && params.fastq) {
 def inputPath = java.nio.file.Paths.get(params.fastq.toString()).toAbsolutePath().normalize()
 def inputFolder = java.nio.file.Files.isDirectory(inputPath) ? inputPath : inputPath.parent
 params.out_dir = inputFolder.resolve('analysis_result').toString()
}

process {
 executor = 'local'
 cpus = params.threads
 memory = '4 GB'
 maxForks = 1
 withLabel: wf_common { container = params.images.wf_common }
 withLabel: wf_bacterial { container = params.images.wf_bacterial }
 withLabel: clair3 { container = params.container ?: params.images.clair3 }
 withLabel: nanoplot { container = params.container ?: params.images.nanoplot }
 withLabel: deeptools { container = params.container ?: params.images.deeptools }
 withLabel: snpeff { container = params.container ?: params.images.snpeff }
 withLabel: snpsift { container = params.container ?: params.images.snpsift }
 shell = ['/bin/bash', '-euo', 'pipefail']
 errorStrategy = 'terminate'
}
docker.enabled = true
profiles {
 standard { docker.enabled = true }
 local { docker.enabled = false }
}
report { enabled = true; file = "${params.out_dir ?: 'output'}/execution/report.html"; overwrite = true }
timeline { enabled = true; file = "${params.out_dir ?: 'output'}/execution/timeline.html"; overwrite = true }
trace { enabled = true; file = "${params.out_dir ?: 'output'}/execution/trace.tsv"; overwrite = true }
